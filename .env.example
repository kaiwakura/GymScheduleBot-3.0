# Copy this file to .env and fill in what you need.
# The app runs without ANY of these: the sample weeks, your own commitments and the keyword-based
# coach all work offline. Never commit .env (it's git-ignored); on Render, set these as environment variables.

# Used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Your local time zone (IANA name).
DEFAULT_TIMEZONE=America/Los_Angeles

# --- Optional: Gemini for the AI Coach (reading messages and schedule screenshots) ---
# Free key: https://aistudio.google.com/apikey  (server-side only; it never reaches the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini calls per 24 hours for the whole site. Each visitor also gets 5 a minute and 40 a day.
AI_DAILY_LIMIT=300

# --- Optional: Google Calendar (see README "Connect Google Calendar") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Encrypts the Google tokens kept in the session cookie. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it signs everyone out of Google (they just reconnect).
TOKEN_ENCRYPTION_KEY=
# Only for local development over http://localhost. Never set this in production.
OAUTHLIB_INSECURE_TRANSPORT=1
